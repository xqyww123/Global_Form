+
+
+(** suspended assumptions **)
+
+(*the suspensions in force, innermost first: token, data before, data put in its place*)
+structure Suspended = Proof_Data
+(
+  type T = (serial * data * data) list;
+  fun init _ = [];
+);
+
+fun suspend token keep ctxt =
+  let
+    val data as Data {rev_assms, rev_prems} = Data.get ctxt;
+    (*the prems of an entry are as many as its assms, at the same place*)
+    val kept =
+      (rev_assms ~~ unflat (map #2 rev_assms) rev_prems)
+      |> filter (fn ((export, asms), _) => keep (export, map (Thm.transfer_cterm' ctxt) asms));
+    val data' = make_data (map #1 kept, maps #2 kept);
+  in ctxt |> Suspended.map (cons (token, data, data')) |> Data.put data' end;
+
+(*entries added since the suspension stay on top*)
+fun resume token ctxt =
+  (case Suspended.get ctxt of
+    (token', Data {rev_assms = assms0, rev_prems = prems0},
+        Data {rev_assms = assms1, rev_prems = prems1}) :: rest =>
+      if token = token' then
+        ctxt
+        |> Suspended.put rest
+        |> map_data (fn (rev_assms, rev_prems) =>
+            (take (length rev_assms - length assms1) rev_assms @ assms0,
+              take (length rev_prems - length prems1) rev_prems @ prems0))
+      else ctxt
+  | [] => ctxt);
+
+(*run f while the contexts reached by map_ctxts, and those derived from them, hold only
+  the entries that satisfy keep*)
+fun suspend_result keep map_ctxts f x =
+  let val token = serial () in
+    x |> map_ctxts (suspend token keep) |> f ||> map_ctxts (resume token)
+  end;
+
 end;
