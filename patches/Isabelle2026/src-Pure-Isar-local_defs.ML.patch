+(*prop defines a fixed variable that term_export expands*)
+fun defines_free term_export prop =
+  (case try head_of_def prop of
+    NONE => false
+  | SOME x =>
+      let val t = Free x in
+        (case try term_export t of
+          NONE => false
+        | SOME u => not (t aconv u))
+      end);
+
+(*assumptions whose own export expands each of them: definitions, not hypotheses*)
+fun is_def_assms ((export, asms): Assumption.export * cterm list) =
+  forall (defines_free (#2 (export false asms)) o Thm.term_of) asms;
+
 
